generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Plan {
  id               String             @id @default(uuid())
  name             String
  billingCycle     String
  price            Float
  setupFee         Float
  originalSetupFee Float?
  salesPointsLimit Int
  productsLimit    Int
  fbrConnect       Boolean            @default(false)
  techSupport      Boolean            @default(false)
  onlineStore      Boolean            @default(false)
  updates          Boolean            @default(false)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  subscriptions    ShopSubscription[]

  @@unique([name, billingCycle])
}

model ShopSubscription {
  id        String    @id @default(uuid())
  shopId    String
  planId    String
  startDate DateTime  @default(now())
  endDate   DateTime?
  status    String    @default("active")
  createdAt DateTime  @default(now())
  plan      Plan      @relation(fields: [planId], references: [id])
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Shop {
  id                  String             @id @default(uuid())
  shopName            String             @unique
  subscriptionPlan    String             @default("NONE")
  subscriptionStatus  String             @default("PENDING")
  subscriptionEndsAt  DateTime?
  isActive            Boolean            @default(true)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  category            ShopCategory       @default(Other)
  slug                String             @unique
  subCategoryId       String?
  supplierId          String?
  managedBySubAdminId String?
  branches            Branch[]
  customers           Customer[]
  invoices            Invoice[]
  ledgerEntries       LedgerEntry[]
  onlineOrders        OnlineOrder[]
  payments            Payment[]
  products            Product[]
  sales               Sale[]
  saleItems           SaleItem[]
  managedBySubAdmin   User?              @relation("ShopsManagedBySubAdmin", fields: [managedBySubAdminId], references: [id])
  Supplier            Supplier?          @relation(fields: [supplierId], references: [id])
  subscriptions       ShopSubscription[]
  users               User[]
}

model Branch {
  id        String   @id @default(uuid())
  shopId    String
  name      String
  address   String   @default("")
  phone     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sales     Sale[]

  @@unique([shopId, name])
}

model Payment {
  id            String   @id @default(uuid())
  shopId        String
  amount        Float
  plan          String
  paymentMethod String
  transactionId String   @default("")
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model User {
  id                  String               @id @default(uuid())
  shopId              String
  email               String               @unique
  passwordHash        String
  role                String               @default("CASHIER")
  name                String
  isActive            Boolean              @default(true)
  emailVerified       Boolean              @default(false)
  canAccessSuppliers  Boolean              @default(false)
  verificationToken   String?
  currentSessionToken String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  auditLogs           AuditLog[]
  invoices            Invoice[]
  passwordResetTokens PasswordResetToken[]
  pendingApprovals    PendingApproval[]    @relation("SubAdminApprovals")
  sales               Sale[]
  managedShops        Shop[]               @relation("ShopsManagedBySubAdmin")
  subAdmin            SubAdmin?
  supplier            Supplier?
  shop                Shop                 @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, email])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id                 String            @id @default(uuid())
  shopId             String
  name               String
  description        String            @default("")
  price              Float
  stock              Int               @default(0)
  sku                String            @default("")
  category           String            @default("General")
  imageUrl           String            @default("")
  isActive           Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  barcode            String?           @unique
  isVisibleOnline    Boolean           @default(true)
  lowStockThreshold  Int               @default(5)
  unitType           String?
  unitValue          Float?
  imei               String?
  warrantyMonths     Int?
  brand              String?
  model              String?
  isMenuItem         Boolean           @default(false)
  recipe             String?
  batchNumber        String?
  expiryDate         DateTime?
  manufacturer       String?
  composition        String?
  dosageForm         String?
  packing            String?
  isControlled       Boolean           @default(false)
  isPrescriptionOnly Boolean           @default(false)
  size               String?
  color              String?
  season             String?
  supplierId         String?
  onlineOrderItems   OnlineOrderItem[]
  shop               Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  Supplier           Supplier?         @relation(fields: [supplierId], references: [id])
  saleItems          SaleItem[]
}

model Sale {
  id            String     @id @default(uuid())
  shopId        String
  userId        String
  total         Float
  subtotal      Float
  tax           Float      @default(0)
  discount      Float      @default(0)
  paymentMethod String     @default("CASH")
  status        String     @default("COMPLETED")
  notes         String     @default("")
  createdAt     DateTime   @default(now())
  customerId    String?
  branchId      String?
  invoice       Invoice?
  branch        Branch?    @relation(fields: [branchId], references: [id])
  customer      Customer?  @relation(fields: [customerId], references: [id])
  shop          Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id])
  saleItems     SaleItem[]

  @@index([branchId])
}

model Invoice {
  id            String   @id @default(uuid())
  invoiceNumber String   @unique
  saleId        String   @unique
  shopId        String
  userId        String
  total         Float
  subtotal      Float
  tax           Float    @default(0)
  discount      Float    @default(0)
  paymentMethod String   @default("CASH")
  createdAt     DateTime @default(now())
  sale          Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id])
}

model SaleItem {
  id        String  @id @default(uuid())
  shopId    String
  saleId    String
  productId String
  quantity  Int
  price     Float
  subtotal  Float
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  shop      Shop    @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model OnlineOrder {
  id              String            @id @default(uuid())
  shopId          String
  customerName    String
  customerPhone   String
  customerAddress String
  status          String            @default("PENDING")
  totalAmount     Float
  source          String            @default("online_store")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  shop            Shop              @relation(fields: [shopId], references: [id], onDelete: Cascade)
  items           OnlineOrderItem[]
}

model OnlineOrderItem {
  id        String      @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  subtotal  Float
  order     OnlineOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product     @relation(fields: [productId], references: [id])
}

model Customer {
  id            String        @id @default(uuid())
  shopId        String
  name          String
  phone         String        @default("")
  totalOwed     Float         @default(0)
  totalPaid     Float         @default(0)
  lastPaymentAt DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  shop          Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  entries       LedgerEntry[]
  sales         Sale[]

  @@unique([shopId, name, phone])
}

model LedgerEntry {
  id         String   @id @default(uuid())
  shopId     String
  customerId String
  type       String
  amount     Float
  saleId     String?
  note       String   @default("")
  createdAt  DateTime @default(now())
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
}

model Supplier {
  id              String                @id @default(uuid())
  userId          String                @unique
  supplierName    String
  businessName    String
  gstNumber       String?
  panNumber       String?
  bankAccountNo   String?
  bankName        String?
  ifscCode        String?
  phone           String
  email           String
  address         String
  city            String
  state           String
  pincode         String
  totalSalesValue Float                 @default(0)
  totalPayments   Float                 @default(0)
  pendingBalance  Float                 @default(0)
  isVerified      Boolean               @default(false)
  isActive        Boolean               @default(true)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  Product         Product[]
  Shop            Shop[]
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    SupplierTransaction[]
}

model SupplierTransaction {
  id          String   @id @default(uuid())
  supplierId  String
  type        String
  amount      Float
  description String?
  referenceNo String?
  createdAt   DateTime @default(now())
  createdBy   String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model SubAdmin {
  id          String   @id @default(uuid())
  userId      String   @unique
  title       String?
  region      String?
  permissions Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  changes    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])
}

model SystemState {
  key   String @id
  value String @default("")
}

model PendingApproval {
  id         String    @id @default(uuid())
  subAdminId String
  action     String
  entityType String
  entityId   String?
  payload    Json?
  status     String    @default("PENDING")
  reviewedBy String?
  reviewNote String?
  createdAt  DateTime  @default(now())
  reviewedAt DateTime?
  subAdmin   User      @relation("SubAdminApprovals", fields: [subAdminId], references: [id])

  @@index([status])
}

enum ShopCategory {
  Grocery
  Electronics
  Restaurant
  Pharmacy
  Clothing
  General
  Other
}
